OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free

USERNAME=
PASSWORD=

EXCEL_FILE=job_applications.xlsx

# Optional: disable extra boards in config.py (Foundit, Remote OK, Surely Remote, Remotive)

# --- Vercel only ---
ENABLE_NAUKRI=true
ENABLE_LINKEDIN=true

# LinkedIn DevOps/AWS Easy Apply
LINKEDIN_MAX_JOBS_PER_QUERY=50
LINKEDIN_SCROLL_ROUNDS=15
LINKEDIN_LOCATION=India

# Browser for google_login.py / linkedin_login.py (Chrome fallback if Brave crashes)
USE_BRAVE_BROWSER=false

CRON_SECRET=generate_a_random_secret
NAUKRI_COOKIES_JSON=
BLOB_READ_WRITE_TOKEN=
EXCEL_BLOB_URL=
